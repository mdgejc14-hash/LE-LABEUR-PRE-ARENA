{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "test": "tsx scripts/run-tests.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "migrate": "tsx scripts/migrate.ts",
    "verify:postgres": "tsx scripts/verify-postgres-e2e.ts",
    "dev:worker": "wrangler dev",
    "dev:worker:scheduled": "wrangler dev --test-scheduled",
    "verify:cloudflare": "tsx scripts/preflight-cloudflare.ts",
    "preflight:cloudflare": "tsx scripts/preflight-cloudflare.ts --require-production --no-bundle",
    "deploy:worker": "tsx scripts/preflight-cloudflare.ts --require-production && wrangler deploy --env production",
    "verify:workerd": "tsx scripts/verify-workerd-local.ts",
    "test:load": "tsx scripts/run-load-tests.ts",
    "design:tokens": "python3 scripts/design/generate-frontend-tokens.py",
    "design:tokens:check": "python3 scripts/design/generate-frontend-tokens.py --check",
    "verify:public-ui": "tsx scripts/verify-public-ui.ts",
    "design:public:check": "python3 scripts/design/generate-public-catalog.py --check",
    "design:employer": "python3 scripts/design/generate-employer-catalog.py",
    "design:employer:check": "python3 scripts/design/generate-employer-catalog.py --check",
    "design:prestataire": "python3 scripts/design/generate-prestataire-catalog.py",
    "design:prestataire:check": "python3 scripts/design/generate-prestataire-catalog.py --check",
    "design:admin": "python3 scripts/design/generate-admin-catalog.py",
    "design:admin:check": "python3 scripts/design/generate-admin-catalog.py --check",
    "verify:employer-ui": "tsx scripts/verify-employer-ui.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@sparticuz/chromium": "^153.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "embedded-postgres": "^17.10.0-beta.17",
    "esbuild": "^0.25.0",
    "playwright-core": "^1.64.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.147.0"
  }
}
