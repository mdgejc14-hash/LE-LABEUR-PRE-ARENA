# Mode démonstration / QA pour LE LABEUR (true pour afficher les contrôles de simulation rapide)
VITE_DEMO_MODE=true

# Google Identity Services (Web Client ID - Clé publique OAuth2, aucun secret en client)
# Obtenu depuis Google Cloud Console > Identifiants > ID client OAuth 2.0 (Application Web)
# Ex: 123456789012-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=

# En mode API, signaling et TURN/ICE sont demandés à l’API authentifiée.
# En mode mock/demo seulement, les valeurs VITE_SIGNALING_TOKEN et VITE_TURN_CREDENTIAL,
# si utilisées, doivent être pré-signées côté serveur et expirer sous 5 minutes.
# Elles sont visibles dans le navigateur : ne jamais y placer une clé HMAC ou un token permanent.
# VITE_SIGNALING_URL et VITE_TURN_SERVER sont des endpoints publics; VITE_STUN_SERVER est public aussi.
# VITE_TURN_USERNAME / VITE_TURN_CREDENTIAL exigent VITE_TURN_EXPIRES_AT (expiration ISO) côté mock.

# ---------------------------------------------------------------------------
# Phase 2 — frontière serveur (Worker). Ces variables NE SONT PAS des VITE_*
# et ne doivent jamais être exposées au bundle navigateur.
# ---------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=            # audience attendue du credential Google (public, côté Worker)
# SESSION_TTL_SECONDS=43200    # durée de vie de la session serveur (défaut 12 h)
# IDENTITY_STORE=postgres      # alias historique de PERSISTENCE (memory | postgres)
# COOKIE_SECURE=true           # mettre 'false' seulement en HTTP local

# ---------------------------------------------------------------------------
# P0-A — persistance PostgreSQL derrière la frontière Worker.
# Ces variables vivent dans l'environnement du Worker uniquement : jamais dans
# le bundle navigateur, jamais commitées avec une valeur réelle.
# Aucune connexion n'est établie tant que PERSISTENCE=postgres et qu'une
# connexion (binding Hyperdrive ou client SQL) n'est pas fournie : sans cela la
# composition reste fermée (jamais de retombée silencieuse vers la mémoire).
# ---------------------------------------------------------------------------
# PERSISTENCE=closed            # 'closed' (défaut) | 'memory' (tests) | 'postgres'
# DB_POOL_MAX=5                 # taille de pool du pilote : 1..20
# DB_STATEMENT_TIMEOUT_MS=15000 # 100..120000 ms
# DB_APPLICATION_NAME=lelabeur-worker  # ^[a-z][a-z0-9_-]{0,31}$
# HYPERDRIVE=                   # binding Cloudflare : expose .connectionString
# POSTGRES_CONNECTION_STRING=   # repli direct (secret) si aucun binding
# Valeur FACTICE documentaire (jamais utilisable telle quelle, refusée comme
# placeholder) : postgresql://user:password@host:5432/database

# Mode API côté navigateur (sinon MODE DEMO / MockRepository) :
# VITE_DEMO_MODE=false et VITE_API_BASE_PATH=/api/v1 (chemin same-origin obligatoire)
# VITE_API_BASE_PATH=

# ---------------------------------------------------------------------------
# P0-PAY-1 — cycle MÉTIER des paiements (aucun paiement réel).
# Le cycle (échéances → déclaration → vérification → rapprochement) est branché
# UNIQUEMENT quand une base PostgreSQL durable existe ; sinon les routes du
# domaine restent 501. Aucun adaptateur de paiement mobile, aucun webhook,
# aucun OTP, aucun KYC n'est branché par cette tranche.
#
# Avance (en millisecondes) du rappel PRÉ-échéance. AUCUNE valeur par défaut :
# absente ou vide, aucun job pré-échéance n'est armé, parce que le modèle des
# règles ne fixe pas de délai. Entier strictement positif, 30 jours maximum.
# ---------------------------------------------------------------------------
# PAYMENT_PRE_DUE_LEAD_TIME_MS=     # ex. 86400000 si l'exploitant le décide

# ---------------------------------------------------------------------------
# P0-DISPUTE-1 — délai de réponse aux demandes de preuve Claim.
# Aucun délai n'est implicite. Valeur facultative, entière et positive en ms;
# l'exploitant doit valider la durée avant de la renseigner.
# CLAIM_EVIDENCE_DEADLINE_MS=

# ---------------------------------------------------------------------------
# P0-CLOUDFLARE-PRODUCTION — infrastructure de production.
#
# Ce bloc documente ce que la PRODUCTION exige. Aucune valeur de secret ne doit
# jamais apparaître dans un fichier versionné : les secrets s'approvisionnent par
#   npx wrangler secret put <NOM> --env production
# Inventaire complet et fermeture associée : docs/P0-CLOUDFLARE_PRODUCTION.md.
# Contrôle avant déploiement : npm run deploy:preflight
# Smoke tests de production (lecture seule) : npm run smoke:production
# ---------------------------------------------------------------------------
# Variables NON secrètes (wrangler.toml, [env.production.vars]) :
# PERSISTENCE=postgres          # la production refuse mémoire/fermé (invariant)
# WORKER_ENV=production         # active les invariants de production
# COOKIE_SECURE=true            # 'false' est REFUSÉ en production
# CRON_CADENCE="*/5 * * * *"    # cadence déclarée, miroir de [env.production.triggers]
# GOOGLE_CLIENT_ID=             # audience OAuth publique ; vide = frontière fermée
#
# Bindings (wrangler.toml) :
#   [[env.production.hyperdrive]]    binding HYPERDRIVE       # à créer puis renseigner
#   [[env.production.r2_buckets]]    binding DOCUMENTS_BUCKET # bucket privé
#
# Secrets (jamais ici, jamais dans wrangler.toml) :
# DOCUMENT_URL_SIGNING_SECRET=  # HMAC ≥ 16 caractères des URL signées documentaires
# POSTGRES_CONNECTION_STRING=   # repli de connexion (dépannage uniquement)
#
# Migrations (hors Worker, opération explicite) :
# MIGRATION_DATABASE_URL=       # chaîne de connexion utilisée par `npm run migrate`
