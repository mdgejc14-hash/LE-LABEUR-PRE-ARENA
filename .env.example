# Mode démonstration / QA pour LE LABEUR (true pour afficher les contrôles de simulation rapide)
VITE_DEMO_MODE=true

# Google Identity Services (Web Client ID - Clé publique OAuth2, aucun secret en client)
# Obtenu depuis Google Cloud Console > Identifiants > ID client OAuth 2.0 (Application Web)
# Ex: 123456789012-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=

# En mode API, signaling et TURN/ICE sont demandés à l’API authentifiée.
# En mode mock/demo seulement, les valeurs VITE_SIGNALING_TOKEN et VITE_TURN_CREDENTIAL,
# si utilisées, doivent être pré-signées côté serveur et expirer sous 5 minutes.
# Elles sont visibles dans le navigateur : ne jamais y placer une clé HMAC ou un token permanent.
# VITE_SIGNALING_URL et VITE_TURN_SERVER sont des endpoints publics; VITE_STUN_SERVER est public aussi.
# VITE_TURN_USERNAME / VITE_TURN_CREDENTIAL exigent VITE_TURN_EXPIRES_AT (expiration ISO) côté mock.

# ---------------------------------------------------------------------------
# Phase 2 — frontière serveur (Worker). Ces variables NE SONT PAS des VITE_*
# et ne doivent jamais être exposées au bundle navigateur.
# ---------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=            # audience attendue du credential Google (public, côté Worker)
# SESSION_TTL_SECONDS=43200    # durée de vie de la session serveur (défaut 12 h)
# IDENTITY_STORE=postgres      # 'postgres' (Hyperdrive) ou 'memory' (tests uniquement)
# COOKIE_SECURE=true           # mettre 'false' seulement en HTTP local
# HYPERDRIVE / DATABASE_URL : non branchés par la Phase 2.

# Mode API côté navigateur (sinon MODE DEMO / MockRepository) :
# VITE_DEMO_MODE=false et VITE_API_BASE_PATH=/api/v1 (chemin same-origin obligatoire)
# VITE_API_BASE_PATH=
